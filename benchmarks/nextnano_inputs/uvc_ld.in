    donor{ name = "nd0" energy = 0.085 degeneracy = 2 }
    donor{ name = "nd1" energy = 0.085 degeneracy = 2 }
    acceptor{ name = "na6" energy = 0.17 degeneracy = 4 }
    charge{ name = "qpos" type = positive }
    charge{ name = "qneg" type = negative }
}
