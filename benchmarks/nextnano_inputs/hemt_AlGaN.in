global{
    simulate1D{}
    crystal_wz{ x_hkl = [0, 0, 1] y_hkl = [1, 0, 0] }
    substrate{ name = "GaN" }
    temperature = 300
}
impurities{
    donor{ name = "nd0" energy = 0.018 degeneracy = 2 }
    charge{ name = "qpos" type = positive }
    charge{ name = "qneg" type = negative }
}
contacts{
    ohmic{ name = "bottom" bias = 0.0 }
    schottky{ name = "top" bias = 0.0 barrier = 1.23 }
}
structure{
    region{ binary{ name = "GaN" } line{ x = [0, 400] } doping{ constant{ name = "nd0" conc = 1e+16 } } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.3 } line{ x = [400, 425] } }
    region{ line{ x = [399.9, 400] } doping{ constant{ name = "qpos" conc = 3.57168e+20 } } }
    region{ line{ x = [400, 400.1] } doping{ constant{ name = "qpos" conc = 3.57168e+20 } } }
    region{ contact{ name = "bottom" } line{ x = [0, 0.1] } }
    region{ contact{ name = "top" } line{ x = [424.9, 425] } }
}
