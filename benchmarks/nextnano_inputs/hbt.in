global{
    simulate1D{}
    crystal_wz{ x_hkl = [0, 0, 1] y_hkl = [1, 0, 0] }
    substrate{ name = "GaN" }
    temperature = 300
}
impurities{
    donor{ name = "nd0" energy = 0.018 degeneracy = 2 }
    donor{ name = "nd1" energy = 0.018 degeneracy = 2 }
    acceptor{ name = "na2" energy = 0.17 degeneracy = 4 }
    donor{ name = "nd3" energy = 0.018 degeneracy = 2 }
    donor{ name = "nd4" energy = 0.018 degeneracy = 2 }
    charge{ name = "qpos" type = positive }
    charge{ name = "qneg" type = negative }
}
contacts{
    ohmic{ name = "bottom" bias = 0.0 }
    ohmic{ name = "top" bias = 0.0 }
}
structure{
    region{ binary{ name = "GaN" } line{ x = [0, 100] } doping{ constant{ name = "nd0" conc = 5e+18 } } }
    region{ binary{ name = "GaN" } line{ x = [100, 400] } doping{ constant{ name = "nd1" conc = 1e+16 } } }
    region{ binary{ name = "GaN" } line{ x = [400, 500] } doping{ constant{ name = "na2" conc = 1e+19 } } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.1 } line{ x = [500, 560] } doping{ constant{ name = "nd3" conc = 5e+17 } } }
    region{ binary{ name = "GaN" } line{ x = [560, 610] } doping{ constant{ name = "nd4" conc = 5e+18 } } }
    region{ line{ x = [499.5592, 500] } doping{ constant{ name = "qpos" conc = 2.46751e+19 } } }
    region{ line{ x = [500, 500.4408] } doping{ constant{ name = "qpos" conc = 2.46751e+19 } } }
    region{ line{ x = [559.5592, 560] } doping{ constant{ name = "qneg" conc = 2.46751e+19 } } }
    region{ line{ x = [560, 560.4408] } doping{ constant{ name = "qneg" conc = 2.46751e+19 } } }
    region{ contact{ name = "bottom" } line{ x = [0, 0.440798] } }
    region{ contact{ name = "top" } line{ x = [609.559, 610] } }
}
