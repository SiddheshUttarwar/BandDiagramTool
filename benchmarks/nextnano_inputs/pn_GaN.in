global{
    simulate1D{}
    crystal_wz{ x_hkl = [0, 0, 1] y_hkl = [1, 0, 0] }
    substrate{ name = "GaN" }
    temperature = 300
}
impurities{
    donor{ name = "nd0" energy = 0.018 degeneracy = 2 }
    acceptor{ name = "na1" energy = 0.17 degeneracy = 4 }
    charge{ name = "qpos" type = positive }
    charge{ name = "qneg" type = negative }
}
contacts{
    ohmic{ name = "bottom" bias = 0.0 }
    ohmic{ name = "top" bias = 0.0 }
}
structure{
    region{ binary{ name = "GaN" } line{ x = [0, 200] } doping{ constant{ name = "nd0" conc = 1e+18 } } }
    region{ binary{ name = "GaN" } line{ x = [200, 400] } doping{ constant{ name = "na1" conc = 1e+19 } } }
    region{ contact{ name = "bottom" } line{ x = [0, 0.5] } }
    region{ contact{ name = "top" } line{ x = [399.5, 400] } }
}
