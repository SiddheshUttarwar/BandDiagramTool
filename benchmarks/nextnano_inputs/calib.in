global{ simulate1D{} crystal_wz{ x_hkl = [0, 0, 1] y_hkl = [1, 0, 0] } substrate{ name = "GaN" } temperature = 300 }
contacts{ ohmic{ name = "c1" bias = 0.0 } ohmic{ name = "c2" bias = 0.0 } }
structure{
    region{ binary{ name = "GaN" } line{ x = [0, 10] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.1 } line{ x = [10, 20] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.2 } line{ x = [20, 30] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.3 } line{ x = [30, 40] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.4 } line{ x = [40, 50] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.5 } line{ x = [50, 60] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.6 } line{ x = [60, 70] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.7 } line{ x = [70, 80] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.8 } line{ x = [80, 90] } }
    region{ ternary_constant{ name = "Al(x)Ga(1-x)N" alloy_x = 0.9 } line{ x = [90, 100] } }
    region{ binary{ name = "AlN" } line{ x = [100, 110] } }
    region{ contact{ name = "c1" } line{ x = [0, 0.5] } }
    region{ contact{ name = "c2" } line{ x = [109.5, 110] } }
}
grid{
    xgrid{
        line{ pos = 0 spacing = 1 }
        line{ pos = 1 spacing = 4 }
        line{ pos = 5 spacing = 4 }
        line{ pos = 9 spacing = 2 }
        line{ pos = 11 spacing = 4 }
        line{ pos = 15 spacing = 4 }
        line{ pos = 19 spacing = 2 }
        line{ pos = 21 spacing = 4 }
        line{ pos = 25 spacing = 4 }
        line{ pos = 29 spacing = 2 }
        line{ pos = 31 spacing = 4 }
        line{ pos = 35 spacing = 4 }
        line{ pos = 39 spacing = 2 }
        line{ pos = 41 spacing = 4 }
        line{ pos = 45 spacing = 4 }
        line{ pos = 49 spacing = 2 }
        line{ pos = 51 spacing = 4 }
        line{ pos = 55 spacing = 4 }
        line{ pos = 59 spacing = 2 }
        line{ pos = 61 spacing = 4 }
        line{ pos = 65 spacing = 4 }
        line{ pos = 69 spacing = 2 }
        line{ pos = 71 spacing = 4 }
        line{ pos = 75 spacing = 4 }
        line{ pos = 79 spacing = 2 }
        line{ pos = 81 spacing = 4 }
        line{ pos = 85 spacing = 4 }
        line{ pos = 89 spacing = 2 }
        line{ pos = 91 spacing = 4 }
        line{ pos = 95 spacing = 4 }
        line{ pos = 99 spacing = 2 }
        line{ pos = 101 spacing = 4 }
        line{ pos = 105 spacing = 4 }
        line{ pos = 109 spacing = 1 }
        line{ pos = 110 spacing = 1 }
    }
}
classical{ Gamma{} HH{} LH{} SO{} output_bandedges{ averaged = no } output_carrier_densities{} }
poisson{ output_potential{} }
run{ poisson{} }
